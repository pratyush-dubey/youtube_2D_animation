# ─────────────────────────────────────────────────────────────────────────────
# AI YouTube Automation — example environment configuration
# Copy this file to .env and fill in the values you need.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json

# ── Paths ──────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
ASSET_DIR=./assets
PROJECT_DIR=./projects

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Default: gemini (generous free tier — 15 RPM, 1M tokens/day)
# Choose one: gemini | openai | ollama
LLM_PROVIDER=gemini

# -- Google Gemini (default — generous free tier) --------------------------------
GEMINI_API_KEY=                       # get from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
# gemini-2.5-flash: 15 RPM, 1 500 RPD free (as of 2025) — recommended
# gemini-2.5-pro:   higher quality, smaller free quota
# List available models: python -c "from google import genai; c=genai.Client(api_key='KEY'); [print(m.name) for m in c.models.list()]"

# -- OpenAI (cloud, paid after free trial credits) --------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Can also point to LM Studio, Together AI, or any OpenAI-compatible endpoint.

# -- Ollama (optional — local only, not needed for cloud deployments) ─────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ── Image Provider ─────────────────────────────────────────────────────────────
# gemini       — Google Imagen 3, BEST quality, uses same GEMINI_API_KEY (RECOMMENDED)
# pollinations — FREE, no API key, cloud-hosted, suitable for testing & development
# stability    — credits-based API, higher quality (https://platform.stability.ai)
# placeholder  — instant, no API, colored rectangles (useful for offline testing)
IMAGE_PROVIDER=gemini

# Stability AI (optional — uncomment to enable)
# STABILITY_API_KEY=

# Tavily search (optional — improves research quality with real web results)
# TAVILY_API_KEY=           # https://tavily.com — generous free tier

# ── TTS Provider ───────────────────────────────────────────────────────────────
# gtts      — DEFAULT: Google Translate TTS, free, internet required
# elevenlabs— cloud TTS, free tier 10k chars/month, best quality
# pyttsx3   — local offline fallback, system voice, no internet needed
TTS_PROVIDER=gtts
TTS_VOICE=en                          # BCP-47 language code (e.g. en, hi, fr)

# ElevenLabs (optional — uncomment to enable)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default voice)

# ── Video settings ─────────────────────────────────────────────────────────────
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=23         # 0–51, lower = better quality and larger file

# FFmpeg binary paths — set these if ffmpeg is NOT on your system PATH.
# Windows example: FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
#                  FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# Leave blank (or omit) to use PATH lookup (default on Linux/Mac/Docker).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# ── Audio mix levels (dB) ──────────────────────────────────────────────────────
NARRATION_VOLUME_DB=-3.0
MUSIC_VOLUME_DB=-24.0
SFX_VOLUME_DB=-14.0
MUSIC_DUCK_DB=-18.0   # music level DURING narration

# ── YouTube ────────────────────────────────────────────────────────────────────
# Obtain credentials from Google Cloud Console → APIs & Services → YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=   # auto-populated after first OAuth flow

# Safety defaults — change ONLY when you are ready to publish
YOUTUBE_PRIVACY_STATUS=private   # private | unlisted | public
AUTO_PUBLISH=false               # NEVER auto-publish unless explicitly set to true
YOUTUBE_CATEGORY_ID=28           # 28 = Science & Technology

# ── Autonomous Scheduler ────────────────────────────────────────────────────────
# Set SCHEDULER_ENABLED=true to start the autonomous scheduler on app startup.
# The scheduler picks a trending topic in the niche every N days and runs the
# full pipeline automatically, uploading as PRIVATE for human review.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_DAYS=3
SCHEDULER_NICHE=science and technology   # or a preset: science|space|history|tech|psychology
SCHEDULER_STYLE=documentary
SCHEDULER_TARGET_DURATION_SECONDS=480

# ── Pipeline tuning ────────────────────────────────────────────────────────────
MAX_RETRIES=3
WORDS_PER_MINUTE=130
SCENE_PADDING_SECONDS=0.5

# ── Content safety ─────────────────────────────────────────────────────────────
CONTENT_SAFETY_ENABLED=true
