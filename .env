# ─────────────────────────────────────────────────────────────────────────────
# AI YouTube Automation — example environment configuration
# Copy this file to .env and fill in the values you need.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json

# ── Paths ──────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
ASSET_DIR=./assets
PROJECT_DIR=./projects

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Choose one: ollama | openai | gemini
LLM_PROVIDER=gemini

# -- Ollama (local, free) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Recommended models (tradeoff: speed vs quality):
#   llama3.1:8b   — fast, good quality, needs ~8 GB RAM
#   llama3.1:70b  — best quality, needs ~48 GB RAM or GPU
#   mistral:7b    — fast alternative
#   phi3:mini     — very fast, less capable

# -- OpenAI (cloud, paid after free tier) ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Can also point to LM Studio, Together AI, or any OpenAI-compatible endpoint.

# -- Google Gemini (cloud, generous free tier) ------------------------------------
GEMINI_API_KEY=AQ.Ab8RN6KQr2mQI2Ma6nRwYOne-t7531dr0rUJihUWe5sLsMSb3g
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini-1.5-flash: 15 req/min, 1M tokens/day free (as of 2025)
# gemini-1.5-pro:  smaller free quota but higher quality

# ── Image Provider ─────────────────────────────────────────────────────────────
# placeholder  — instant, no GPU, colored rectangles (great for testing)
# stable_diffusion — local, via HuggingFace diffusers (needs GPU for speed)
# automatic1111 — local AUTOMATIC1111 WebUI REST API
IMAGE_PROVIDER=gemini
# SD_MODEL_ID=runwayml/stable-diffusion-v1-5
# A1111_BASE_URL=http://localhost:7860

# ── TTS Provider ───────────────────────────────────────────────────────────────
# piper  — local, MIT license, fast CPU inference (recommended)
# coqui  — local, MPL2, higher quality but heavier
# gtts   — Google TTS (requires internet, free, not for commercial use)
TTS_PROVIDER=gtts
PIPER_MODEL=en_US-lessac-medium
# Download voice models from: https://huggingface.co/rhasspy/piper-voices

# ── Video settings ─────────────────────────────────────────────────────────────
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_CRF=23         # 0–51, lower = better quality and larger file

# ── Audio mix levels (dB) ──────────────────────────────────────────────────────
NARRATION_VOLUME_DB=-3.0
MUSIC_VOLUME_DB=-24.0
SFX_VOLUME_DB=-14.0
MUSIC_DUCK_DB=-18.0   # music level DURING narration

# ── YouTube ────────────────────────────────────────────────────────────────────
# Obtain credentials from Google Cloud Console → YouTube Data API v3
YOUTUBE_CLIENT_ID= 
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=   # auto-populated after first OAuth flow

# safety defaults — change ONLY when you are ready to publish
YOUTUBE_PRIVACY_STATUS=private   # private | unlisted | public
AUTO_PUBLISH=false               # never auto-publish unless explicitly set to true
YOUTUBE_CATEGORY_ID=28           # 28 = Science & Technology

# ── Pipeline tuning ────────────────────────────────────────────────────────────
MAX_RETRIES=3
WORDS_PER_MINUTE=130
SCENE_PADDING_SECONDS=0.5

# ── Content safety ─────────────────────────────────────────────────────────────
CONTENT_SAFETY_ENABLED=true
